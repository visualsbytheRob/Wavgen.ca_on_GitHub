{
  "name": "wavgen-website",
  "version": "1.0.0",
  "description": "The Waveform Generation - Rob McDonald's Creative Portfolio",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "concurrently \"npm run watch-css\" \"eleventy --serve\" \"node scripts/save-entry-server.js\"",
    "build-css": "tailwindcss -i ./src/input.css -o ./src/css/style.css",
    "build": "npm run build-css && eleventy && npm run validate:feed",
    "serve": "eleventy --serve",
    "debug": "DEBUG=Eleventy* eleventy",
    "test": "npm run test:schema && npm run test:theme && npm run test:performance && npm run test:accessibility && npm run test:feed",
    "new:diary": "node scripts/new-diary-entry.js",
    "diary:api": "node scripts/save-entry-server.js",
    "refresh:feeds": "node scripts/refresh-latest-feeds.js",
    "refresh:projects": "node scripts/refresh-projects.js",
    "refresh:monthly": "npm run refresh:feeds && npm run refresh:projects",
    "briefing:generate": "node scripts/generate-briefing.js",
    "diary:pick": "node scripts/pick-diary-prompt.js",
    "diary:collect": "node scripts/collect-diary-replies.js",
    "watch-css": "tailwindcss -i ./src/input.css -o ./src/css/style.css --watch",
    "test:schema": "node --test src/_utils/*.test.js && node scripts/test-schema-build.cjs",
    "test:theme": "node scripts/test-theme.cjs && node scripts/check-contrast.cjs",
    "test:performance": "node scripts/test-performance.cjs",
    "measure": "node scripts/measure-output.cjs",
    "test:accessibility": "node scripts/prepare-a11y-baseline.cjs && node scripts/test-accessibility.cjs && node scripts/test-layout-with-feed.cjs",
    "validate:feed": "node scripts/validate-feed.js",
    "test:feed": "node scripts/test-feed.cjs"
  },
  "dependencies": {
    "@11ty/eleventy": "^2.0.1",
    "express": "^4.18.2",
    "imapflow": "^1.3.3",
    "mailparser": "^3.9.8",
    "nodemailer": "^8.0.7",
    "parse5": "^7.3.0",
    "saxes": "^6.0.0",
    "tailwindcss": "^3.3.0",
    "three": "0.187.0"
  },
  "devDependencies": {
    "concurrently": "^9.2.0",
    "nodemon": "^3.0.1",
    "playwright": "1.62.1"
  }
}
