{#
This template renders the navigation menus (both mobile and desktop) for the site.
- It loops through navigation items and renders links for each main section.
- If a section has children, it creates a dropdown or indented sublinks.

Each navigation item uses the same structure:
  - Main link
  - Optional dropdown for children

Only the first navigation item is commented in detail; all following items are analogous.
#}
<!-- Mobile Navigation Overlay -->
<div id="mobile-nav-overlay" class="fixed inset-0 bg-black bg-opacity-50 z-[9999] hidden"></div>

<!-- Mobile Navigation Drawer -->
<nav id="mobile-nav" aria-label="Mobile navigation" inert class="fixed top-0 left-0 h-full w-80 max-w-full bg-wavgen-purple z-[10000] transform -translate-x-full transition-transform duration-300 ease-in-out">
  <div class="h-full flex flex-col">
    <!-- Header -->
    <div class="flex justify-between items-center p-4 border-b border-wavgen-dark-purple">
      <h2 class="text-lg font-bold text-wavgen-yellow">Navigation</h2>
      <!-- Subtle easter egg: tiny link to Site Log (/diary/) in mobile drawer header -->
      <a href="/diary/" aria-label="Open Site Log" title=" " class="ml-2 inline-flex items-center justify-center w-3 h-3 rounded-full bg-wavgen-yellow/70 opacity-30 hover:opacity-100 transition-opacity" onclick="try{sessionStorage.setItem('siteLogUnlocked','1');}catch(e){}"></a>
      <button id="close-mobile-nav" aria-label="Close navigation" class="control-btn text-white hover:text-wavgen-yellow">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <!-- Scrollable Menu -->
    <div class="flex-1 overflow-y-auto py-2">
      <nav class="flex flex-col space-y-1 px-4">
        {% if navigation.main and navigation.main.length > 0 %}
          {% for item in navigation.main.concat(navigation.utility) %}
            <a href="{{ item.url }}" class="wg-mobile-nav-object font-bold text-white hover:text-wavgen-yellow py-2 px-2 rounded transition-all duration-200{% if item.url | isActiveSection(page.url) %} bg-wavgen-dark-purple{% endif %}">
              <img class="wg-nav-object" src="{{ item.object }}" width="32" height="32" alt=""> {{ item.title }}
            </a>
            {% if item.children %}
              {% for child in item.children %}
                <a href="{{ child.url }}" class="block text-white hover:text-wavgen-yellow py-2 px-6 rounded transition-all duration-150 text-base{% if child.url | isCurrentPage(page.url) %} bg-wavgen-purple{% endif %}">
                  {{ child.title }}
                </a>
              {% endfor %}
            {% endif %}
          {% endfor %}
        {% else %}
          <span class="block text-red-400 py-4">Navigation data not found!</span>
        {% endif %}
        <a href="https://wavgen.myshopify.com/search" class="block text-white hover:text-wavgen-yellow py-2 px-2">Search the store</a>
        <a href="https://wavgen.myshopify.com/account" class="block text-white hover:text-wavgen-yellow py-2 px-2">Shop account</a>
        <a href="https://wavgen.myshopify.com/cart" class="block text-white hover:text-wavgen-yellow py-2 px-2">Shopping cart</a>
      </nav>
    </div>
  </div>
</nav>

{% include "components/storefront-header.njk" %}
