---

layout: base.njk

---

{% set section = domain or 'data' %}

{% set heading = title | pageHeading %}

<nav class="bg-gray-800 py-4" aria-label="Breadcrumb"><div class="container mx-auto px-4"><a href="/" class="text-wavgen-yellow">Home</a> <span aria-hidden="true"> / </span><a href="/{{ section }}/" class="text-wavgen-yellow">{{ section | capitalize }}</a> <span aria-hidden="true"> / </span><span>{{ heading }}</span></div></nav>

{% set hero = {title: heading, description: description, images: approvedImages[section], theme: section, gradient: {'from': 'from-gray-900', via: 'via-wavgen-dark-purple', to: 'to-wavgen-purple'} } %}

{% include "components/hero.njk" %}

{{ content | safe }}

<section class="world-content-section" aria-label="{{ heading }} interactive guide">

<div class="container mx-auto px-4 py-4"><h2 class="text-2xl font-bold">Explore {{ heading }}</h2><p>Use the interactive guide below, or <a class="text-wavgen-yellow" href="/worlds/{{ worldFile }}" target="_blank" rel="noopener">open it in its own tab</a>.</p></div>

<iframe src="/worlds/{{ worldFile }}" class="wg-world-frame" loading="lazy" allowfullscreen title="{{ heading }} interactive guide"></iframe>

</section>

<style>.world-content-section{background:#100c18;color:#eee8f6}.wg-world-frame{display:block;width:100%;height:85vh;min-height:600px;border:0}</style>
